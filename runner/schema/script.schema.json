{
  "$comment": "What the LLM must return at the script gate (gate 1). Rendered to script.md by gates/script.",
  "type": "object",
  "required": ["title", "open", "sections", "own"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "open": {
      "type": "object",
      "required": ["problem", "promise"],
      "additionalProperties": false,
      "properties": {
        "problem": { "type": "string", "minLength": 1 },
        "promise": { "type": "string", "minLength": 1 },
        "cta": { "type": ["string", "null"] },
        "credibility": { "type": ["string", "null"] }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["name", "narration"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "narration": { "type": "string", "minLength": 1 },
          "callout": { "type": ["string", "null"], "maxLength": 60 },
          "highestValue": { "type": "boolean" }
        }
      }
    },
    "ownershipCta": { "type": ["string", "null"] },
    "commentCalls": {
      "$comment": "Written by the runner, not the LLM: the comment calls this script was written for (runner/cta), so the scene gate can find them.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["slot", "keyword", "temperature"],
        "additionalProperties": false,
        "properties": {
          "slot": { "enum": ["start", "middle", "end"] },
          "keyword": { "type": "string", "pattern": "^[A-Z]{2,12}$" },
          "temperature": { "enum": ["cold", "warm", "hot"] },
          "gets": { "type": ["string", "null"] },
          "offer": { "type": ["string", "null"] }
        }
      }
    },
    "segmentCalls": {
      "$comment": "Written by the runner: the places a segment fills (cta/segments.mjs), its clip copied into the project. The script has no call there.",
      "type": "array",
      "maxItems": 3,
      "items": { "type": "object", "required": ["slot", "keyword", "file", "seconds"] }
    },
    "endScreen": { "type": "number", "minimum": 0, "maximum": 20 },
    "publishing": {
      "$comment": "Written by the runner, not the LLM: what the publishing data needs from gate 1 (gates/render/publish.mjs).",
      "type": "object"
    },
    "own": {
      "type": "object",
      "required": ["recap"],
      "additionalProperties": false,
      "properties": {
        "recap": { "type": "string", "minLength": 1 },
        "cta": { "type": ["string", "null"] },
        "nextVideo": { "type": ["string", "null"] }
      }
    }
  }
}
