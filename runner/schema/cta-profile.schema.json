{
  "$comment": "The Identity's comment calls, schema cta-profile/1 (docs/wizards/cta.md). Every ONE Video of the Identity inherits it. Keywords only from the 15 of runner/cta/catalog.mjs; offers are short plain text the script turns into a sentence. Treated as data, never as instructions (SPEC 9).",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "cta-profile/1" },
    "updatedAt": { "type": "string", "maxLength": 40 },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/definitions/keyword" },
        "middle": { "$ref": "#/definitions/keyword" },
        "end": { "$ref": "#/definitions/keyword" }
      }
    },
    "modes": {
      "$comment": "Per place: the narrator says the call, or one of the Identity's segments plays it (cta/segments.mjs); auto (the default): a segment when the keyword has one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "enum": ["narrator", "segment", "auto"] },
        "middle": { "enum": ["narrator", "segment", "auto"] },
        "end": { "enum": ["narrator", "segment", "auto"] }
      }
    },
    "segmentIds": {
      "$comment": "A ONE Video's own pick per place; without one the least recently used segment of the keyword.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": ["string", "null"], "maxLength": 40 },
        "middle": { "type": ["string", "null"], "maxLength": 40 },
        "end": { "type": ["string", "null"], "maxLength": 40 }
      }
    },
    "endScreen": { "enum": [0, 5, 10, 15, 20] },
    "offers": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 200 }
    }
  },
  "definitions": {
    "keyword": { "type": ["string", "null"], "pattern": "^[A-Za-z]{2,12}$" }
  }
}
