{
  "$comment": "Video Publishing Card, schema video-publishing-card/1 (runner/gates/render/publish.mjs, DECISIONS 114), the successor of itv-publish/1. Written next to every rendered video as <video>.card.json, and the body of POST {url}/api/v1/cards (Send to Publishing). Facts the app knows exactly, plus the packaging chosen at gate 1. cardId is generated once per project and kept, so a card sent again updates the same one; videoId is the YouTube id, filled by the publishing app. Fields are only ever added (series, DECISIONS 122, and thumbnail, DECISIONS 131, are such: optional, the version stays 1); a breaking change gets video-publishing-card/2.",
  "type": "object",
  "required": [
    "schema",
    "cardId",
    "videoId",
    "createdAt",
    "video",
    "chapters",
    "captions",
    "script",
    "sentences",
    "commentCalls"
  ],
  "properties": {
    "schema": {
      "const": "video-publishing-card/1"
    },
    "cardId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "videoId": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "app": {
      "type": "object"
    },
    "video": {
      "type": "object",
      "required": [
        "file",
        "seconds",
        "language"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "language": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "workingTitle": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "searchKeyword": {
      "type": [
        "string",
        "null"
      ]
    },
    "landingUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "next": {
      "type": "object"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "title"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "chaptersText": {
      "type": "string"
    },
    "captions": {
      "type": "object",
      "required": [
        "file",
        "language"
      ],
      "properties": {
        "srt": {
          "type": "string"
        }
      }
    },
    "script": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "heading",
          "text"
        ]
      }
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ]
      }
    },
    "commentCalls": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "slot",
          "keyword",
          "temperature"
        ],
        "properties": {
          "slot": {
            "enum": [
              "start",
              "middle",
              "end"
            ]
          },
          "keyword": {
            "type": "string",
            "pattern": "^[A-Z]{2,12}$"
          },
          "temperature": {
            "enum": [
              "cold",
              "warm",
              "hot"
            ]
          },
          "gets": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": [
              "number",
              "null"
            ]
          },
          "end": {
            "type": [
              "number",
              "null"
            ]
          },
          "via": {
            "enum": [
              "narrator",
              "segment"
            ]
          },
          "said": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "endScreen": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "startSec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "syntheticMedia": {
      "type": "boolean",
      "description": "A generated clip (AI B-roll) is in the video: answer YouTube Studio's altered or synthetic content question."
    },
    "series": {
      "type": "object",
      "description": "Optional. Only on a video that is one lesson of an imported course (DECISIONS 122). A receiver that does not know it ignores it.",
      "required": [
        "courseSlug",
        "lessonId",
        "playlistPosition",
        "playlistId"
      ],
      "properties": {
        "courseSlug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 60
        },
        "lessonId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 40
        },
        "playlistPosition": {
          "type": "integer",
          "minimum": 1
        },
        "playlistId": {
          "type": [
            "string",
            "null"
          ]
        },
        "playlistUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "packaging": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "titles",
        "title",
        "summary",
        "tags"
      ],
      "properties": {
        "titles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "description": "Optional. The thumbnail chosen in IdeaToVideo's Thumbnail step (DECISIONS 131): a JPEG under 1 MB, inside the card as base64, so the card stays under the publishing app's 2 MB. A receiver that does not know it ignores it.",
      "required": [
        "file",
        "mime",
        "width",
        "height",
        "bytes",
        "sha256",
        "withFace",
        "data"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "mime": {
          "enum": [
            "image/jpeg",
            "image/png"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 640
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "words": {
          "type": [
            "string",
            "null"
          ]
        },
        "withFace": {
          "type": "boolean"
        },
        "data": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
