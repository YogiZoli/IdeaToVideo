{
  "$comment": "project.json, SPEC 4.4. The source of truth for a project's state.",
  "type": "object",
  "required": ["schema", "id", "status", "language", "gates"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9-]+$" },
    "title": { "type": "string", "maxLength": 300 },
    "status": { "enum": ["Idea", "Scripted", "Voiced", "Scened", "Reviewed", "Rendered", "Done"] },
    "language": { "type": "string", "minLength": 2, "maxLength": 10 },
    "autopilot": { "type": "boolean" },
    "identity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$" },
    "createdAt": { "type": "string" },
    "cardId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "$comment": "the Video Publishing Card id, made once at the first render and kept (DECISIONS 114)" },
    "autopilotRun": {
      "type": "object",
      "$comment": "Finish on Autopilot is under way (the UI goes on with it when the ONE Video is opened again)",
      "additionalProperties": false,
      "properties": { "at": { "type": "string" } }
    },
    "render": {
      "type": "object",
      "$comment": "the last render: running, done or failed, so a failed one is seen after a restart",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["running", "done", "failed"] },
        "at": { "type": "string" },
        "pid": { "type": "integer" },
        "quality": { "type": "string", "maxLength": 20 },
        "file": { "type": "string", "maxLength": 1000 },
        "error": { "type": "string", "maxLength": 2000 }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script": { "$ref": "#/definitions/gate" },
        "voice": { "$ref": "#/definitions/gate" },
        "scenes": { "$ref": "#/definitions/gate" },
        "review": { "$ref": "#/definitions/gate" },
        "avatar": { "$ref": "#/definitions/gate" }
      }
    }
  },
  "definitions": {
    "gate": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["todo", "running", "pending", "approved", "skipped", "failed"] },
        "mode": { "enum": ["recommended", "default", "custom"] },
        "at": { "type": "string" },
        "pid": { "type": "integer", "$comment": "the runner process of a running gate, to spot one interrupted by a closed app" },
        "reason": { "type": "string", "maxLength": 500 },
        "error": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
