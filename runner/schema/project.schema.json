{
  "$comment": "project.json, SPEC 4.4. The source of truth for a project's state.",
  "type": "object",
  "required": ["schema", "id", "status", "language", "gates"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9-]+$" },
    "title": { "type": "string", "maxLength": 300 },
    "status": { "enum": ["Idea", "Scripted", "Voiced", "Scened", "Reviewed", "Rendered", "Done"] },
    "language": { "type": "string", "minLength": 2, "maxLength": 10 },
    "autopilot": { "type": "boolean" },
    "identity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$" },
    "createdAt": { "type": "string" },
    "cardId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "$comment": "the Video Publishing Card id, made once at the first render and kept (DECISIONS 114)" },
    "series": {
      "type": "object",
      "$comment": "this ONE Video is one lesson of an imported course (runner/course/index.mjs, DECISIONS 121); courseSlug plus lessonId is the lesson's key",
      "required": ["courseSlug", "lessonId", "playlistPosition"],
      "additionalProperties": false,
      "properties": {
        "courseSlug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
        "courseTitle": { "type": "string", "maxLength": 300 },
        "lessonId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
        "playlistPosition": { "type": "integer", "minimum": 1 },
        "playlistCount": { "type": "integer", "minimum": 1 },
        "playlistId": { "type": ["string", "null"], "maxLength": 100 },
        "playlistUrl": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "recipe": {
      "type": "object",
      "$comment": "the channel's locked recipe when this video was started (channels/recipe.mjs, DECISIONS 132): changing the recipe later never changes a video under way"
    },
    "queue": {
      "type": "object",
      "$comment": "this video's place in a Week batch (channels/batch.mjs, DECISIONS 136)",
      "required": ["batch", "position", "of"],
      "additionalProperties": false,
      "properties": {
        "batch": { "type": "string", "maxLength": 40 },
        "position": { "type": "integer", "minimum": 1 },
        "of": { "type": "integer", "minimum": 1 },
        "angle": { "type": "string", "maxLength": 400 }
      }
    },
    "publishing": {
      "type": "object",
      "$comment": "the last Send to Publishing that the publishing app took (DECISIONS 127)",
      "required": ["sentAt"],
      "additionalProperties": false,
      "properties": {
        "sentAt": { "type": "string" },
        "cardId": { "type": "string", "maxLength": 100 }
      }
    },
    "upload": {
      "type": "object",
      "$comment": "the user ticked Uploaded: upload stays manual in YouTube Studio (DECISIONS 127)",
      "required": ["at", "url", "videoId"],
      "additionalProperties": false,
      "properties": {
        "at": { "type": "string" },
        "url": { "type": "string", "maxLength": 300 },
        "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" }
      }
    },
    "autopilotRun": {
      "type": "object",
      "$comment": "Finish on Autopilot is under way (the UI goes on with it when the ONE Video is opened again)",
      "additionalProperties": false,
      "properties": { "at": { "type": "string" } }
    },
    "render": {
      "type": "object",
      "$comment": "the last render: running, done or failed, so a failed one is seen after a restart",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["running", "done", "failed"] },
        "at": { "type": "string" },
        "pid": { "type": "integer" },
        "quality": { "type": "string", "maxLength": 20 },
        "file": { "type": "string", "maxLength": 1000 },
        "error": { "type": "string", "maxLength": 2000 }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script": { "$ref": "#/definitions/gate" },
        "voice": { "$ref": "#/definitions/gate" },
        "scenes": { "$ref": "#/definitions/gate" },
        "review": { "$ref": "#/definitions/gate" },
        "avatar": { "$ref": "#/definitions/gate" }
      }
    }
  },
  "definitions": {
    "gate": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["todo", "running", "pending", "approved", "skipped", "failed"] },
        "mode": { "enum": ["recommended", "default", "custom"] },
        "at": { "type": "string" },
        "pid": { "type": "integer", "$comment": "the runner process of a running gate, to spot one interrupted by a closed app" },
        "reason": { "type": "string", "maxLength": 500 },
        "error": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
