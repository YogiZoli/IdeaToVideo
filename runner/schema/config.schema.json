{
  "$comment": "config.json, the App level (SPEC 4.1, docs/identity.md 3). Schema 2: everything about a brand, pen name or client lives in identities/<id>/identity.json. Non-secret settings only: API keys live in the OS keychain, never here.",
  "type": "object",
  "required": ["schema", "llm"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 2},
    "onboarded": {"type": "boolean"},
    "ui": {"type": "object", "additionalProperties": false, "properties": {"language": {"enum": ["en"]}}},
    "llm": {
      "type": "object",
      "required": ["provider", "model"],
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["gemini", "openrouter", "claude", "openai", "deepseek", "grok"]},
        "model": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "projectsDir": {"type": ["string", "null"], "maxLength": 1000},
    "activeIdentity": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"},
    "defaults": {"type": "object", "additionalProperties": false, "properties": {"autopilot": {"type": "boolean"}}}
  }
}
