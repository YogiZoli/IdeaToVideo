          "id": "headline",
          "type": "string",
          "label": "Headline",
          "default": "",
          "maxWords": 8
        },
        {
          "id": "object",
          "type": "string",
          "label": "Object",
          "default": "figure",
          "optional": true
        },
        {
          "id": "kicker",
          "type": "string",
          "label": "Kicker",
          "default": "",
          "optional": true,
          "maxWords": 4
        }
