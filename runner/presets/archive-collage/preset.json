    },
    {
      "id": "path",
      "label": "Four stops",
      "when": "Exactly four steps in order, joined by one line.",
      "params": {
        "step1": {
          "maxWords": 3,
          "required": true
        },
        "step2": {
          "maxWords": 3,
          "required": true
        },
        "step3": {
          "maxWords": 3,
          "required": true
        },
        "step4": {
          "maxWords": 3,
          "required": true
        }
      },
      "use": [
        {
          "component": "archive-collage:path",
          "vars": {
            "step1": "$step1",
            "step2": "$step2",
            "step3": "$step3",
            "step4": "$step4"
          }
        }
      ]
    },
    {
      "id": "alert",
      "label": "The alert",
      "when": "Rarely, at the one moment of crisis: the whole frame floods with the accent color.",
      "rare": {
        "every": 16
      },
      "params": {
        "line": {
          "maxWords": 6,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:alert",
          "vars": {
            "line": "$line",
            "object": "$object"
          }
        }
      ]
