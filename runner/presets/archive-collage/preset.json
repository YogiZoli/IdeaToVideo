{
  "schema": "style-preset/1",
  "id": "archive-collage",
  "label": "Archive Collage",
  "description": "A documentary collage explainer. Halftone cutouts on aged paper and maps, giant numbers, map pins and route lines, torn edges and print grain, one hot accent. Layers move in parallax under one slow camera drift.",
  "engine": "script",
  "scriptNote": "A documentary explainer built on facts. Name the real places, and say the years and the key numbers in digits. Write sentences of 8 to 16 words, one fact per sentence, because each one gets its own shot. Never name or describe a real person's looks.",
  "ideaNote": "Each video explains how something in history, money or the world really happened, with places, dates and numbers.",
  "defaults": {
    "broll": false
  },
  "tokens": {
    "appearance": "light",
    "colors": {
      "background": "#e6dbc2",
      "surface": "#f3ebd8",
      "border": "#bdae8c",
      "text": "#17140f",
      "muted": "#5f5441",
      "primary": "#e8401c",
      "secondary": "#0e6a70",
      "tertiary": "#5f5441"
    },
    "fonts": {
      "display": "Archivo Black",
      "body": "Newsreader"
    },
    "shape": {
      "corners": "none",
      "cards": "flat"
    },
    "texture": "aged paper, map lines, print grain, matte"
  },
  "shotRules": {
    "pacing": "balanced",
    "cutFrequency": "A new shot on most sentences, plain cuts.",
    "camera": "One slow drift per scene, layers at different depths move in real parallax. The scene owns it, not the channel's Motion profile.",
    "characters": "Generic faceless figures drawn by code as halftone cutouts. Never a recognizable real person.",
    "sound": "No transition sounds. The narration carries the video, the music sits under it."
  },
  "assets": [
    {
      "title": "Natural Earth 1:50m countries and 1:110m populated places, simplified",
      "source": "natural-earth",
      "sourceUrl": "https://www.naturalearthdata.com/",
      "license": "pd",
      "licenseUrl": "https://www.naturalearthdata.com/about/terms-of-use/",
      "author": "Natural Earth",
      "date": "2026-11-03"
    }
  ],
  "places": "places.json",
