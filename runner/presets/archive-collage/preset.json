  "templates": [
    {
      "id": "title",
      "label": "Torn headline and cutout",
      "when": "The first scene: the video's question or claim, with a cutout of what it is about.",
      "params": {
        "headline": {
          "maxWords": 8,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        },
        "kicker": {
          "maxWords": 4,
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:title",
          "vars": {
            "headline": "$headline",
            "object": "$object",
            "kicker": "$kicker"
          }
        }
      ]
    },
    {
      "id": "chapter",
      "label": "A new sheet",
      "when": "The start of a new part of the story.",
      "params": {
        "headline": {
          "maxWords": 5,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:chapter",
          "vars": {
            "headline": "$headline",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "statement",
      "label": "Two torn strips",
      "when": "A plain claim: the first strip sets it up, the second lands it.",
      "params": {
        "line1": {
          "maxWords": 5,
          "required": true
        },
        "line2": {
          "maxWords": 4,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:statement",
          "vars": {
            "line1": "$line1",
            "line2": "$line2",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "word",
      "label": "One huge word",
      "when": "One word is the whole point.",
      "params": {
        "word": {
          "maxWords": 2,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:word",
          "vars": {
            "word": "$word",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "highlight",
      "label": "Underline swipe",
      "when": "A short line with one key word to underline.",
      "params": {
        "line": {
          "maxWords": 6,
          "required": true
        },
        "mark": {
          "maxWords": 1,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:highlight",
          "vars": {
            "line": "$line",
            "mark": "$mark",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "question",
      "label": "A question on the desk",
      "when": "The narration asks the viewer something.",
      "ruleFirst": true,
      "params": {
        "question": {
          "maxWords": 6,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:question",
          "vars": {
            "question": "$question",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "versus",
      "label": "Torn in two",
      "when": "This or that, before and after, two sides.",
      "ruleFirst": true,
      "params": {
        "left": {
          "maxWords": 4,
          "required": true
        },
        "right": {
          "maxWords": 4,
          "required": true
        },
        "leftObject": {
          "type": "object",
          "required": false
        },
        "rightObject": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:versus",
          "vars": {
            "left": "$left",
            "right": "$right",
            "leftObject": "$leftObject",
            "rightObject": "$rightObject"
          }
        }
      ]
    },
    {
      "id": "cause",
      "label": "A leads to B",
      "when": "One thing causes or leads to another.",
      "ruleFirst": true,
      "params": {
        "from": {
          "maxWords": 3,
          "required": true
        },
        "to": {
          "maxWords": 3,
          "required": true
        },
        "fromObject": {
          "type": "object",
          "required": false
        },
        "toObject": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:cause",
          "vars": {
            "from": "$from",
            "to": "$to",
            "fromObject": "$fromObject",
            "toObject": "$toObject"
          }
        }
      ]
    },
    {
      "id": "year",
      "label": "A date stamp",
      "when": "The narration says the year something happened.",
      "ruleFirst": true,
      "params": {
        "value": {
          "type": "number",
          "required": true,
          "said": true
        },
        "line": {
          "maxWords": 6,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:year",
          "vars": {
            "value": "$value",
            "line": "$line",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "route",
      "label": "A route on the map",
      "when": "Something moves between two places the narration names: a route line on the map.",
      "ruleFirst": true,
      "params": {
        "fromPlace": {
          "type": "place",
          "required": true
        },
        "toPlace": {
          "type": "place",
          "required": true
        },
        "fromLabel": {
          "maxWords": 3,
          "required": false
        },
        "toLabel": {
          "maxWords": 3,
          "required": false
        },
        "line": {
          "maxWords": 6,
          "required": false
        }
      },
      "use": [
        {
          "component": "archive-collage:route",
          "vars": {
            "fromPlace": "$fromPlace",
            "toPlace": "$toPlace",
            "fromLabel": "$fromLabel",
            "toLabel": "$toLabel",
            "line": "$line"
          }
        }
      ]
    },
    {
      "id": "map",
