  "places": "../archive-collage/places.json",
  "templates": [
    {
      "id": "title",
      "label": "A figure under a street light",
      "when": "The first scene: the video's question or claim.",
      "params": {
        "headline": {
          "maxWords": 8,
          "required": true
        },
        "kicker": {
          "maxWords": 4,
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:title",
          "vars": {
            "headline": "$headline",
            "kicker": "$kicker"
          }
        }
      ]
    },
    {
      "id": "chapter",
      "label": "A folder and a flashlight",
      "when": "The start of a new part of the story.",
      "params": {
        "headline": {
          "maxWords": 5,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:chapter",
          "vars": {
            "headline": "$headline",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "statement",
      "label": "Two lines in a dark room",
      "when": "A plain claim: the first line sets it up, the second lands it.",
      "params": {
        "line1": {
          "maxWords": 5,
          "required": true
        },
        "line2": {
          "maxWords": 4,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:statement",
          "vars": {
            "line1": "$line1",
            "line2": "$line2",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "word",
      "label": "One word like a lit sign",
      "when": "One word is the whole point.",
      "params": {
        "word": {
          "maxWords": 2,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:word",
          "vars": {
            "word": "$word",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "highlight",
      "label": "A line with one word marked",
      "when": "A short line with one key word to underline.",
      "params": {
        "line": {
          "maxWords": 6,
          "required": true
        },
        "mark": {
          "maxWords": 1,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:highlight",
          "vars": {
            "line": "$line",
            "mark": "$mark",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "flash",
      "label": "A light flash and a sound",
      "when": "Something violent or sudden happens. Nothing is shown: only windows flash in the dark and a dull sound is heard. Never name a weapon or an injury in its line.",
      "ruleFirst": true,
      "fallback": true,
      "params": {
        "object": {
          "type": "object",
          "required": true
        },
        "line": {
          "maxWords": 9,
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:flash",
          "vars": {
            "object": "$object",
            "line": "$line"
          }
        }
      ]
    },
    {
      "id": "question",
      "label": "Somebody in a lit doorway",
      "when": "The narration asks the viewer something.",
      "ruleFirst": true,
      "params": {
        "question": {
          "maxWords": 6,
          "required": true
        }
      },
      "use": [
        {
          "component": "night-case-file:question",
          "vars": {
            "question": "$question"
          }
        }
      ]
    },
    {
      "id": "stamp",
      "label": "A date and place stamp",
      "when": "The narration says when something happened: a date, a year or a time, and where if it says so.",
      "ruleFirst": true,
      "params": {
        "when": {
          "maxWords": 4,
          "required": true,
          "said": true
        },
        "where": {
          "maxWords": 3,
          "required": false
        },
        "line": {
          "maxWords": 8,
          "required": false
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:stamp",
          "vars": {
            "when": "$when",
            "where": "$where",
            "line": "$line",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "route",
      "label": "A route on the dark map",
      "when": "Somebody or something moves between two places the narration names.",
      "ruleFirst": true,
      "params": {
        "fromPlace": {
          "type": "place",
          "required": true
        },
        "toPlace": {
          "type": "place",
          "required": true
        },
        "fromLabel": {
          "maxWords": 3,
          "required": false
        },
        "toLabel": {
          "maxWords": 3,
          "required": false
        },
        "line": {
          "maxWords": 9,
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:route",
          "vars": {
            "fromPlace": "$fromPlace",
            "toPlace": "$toPlace",
            "fromLabel": "$fromLabel",
            "toLabel": "$toLabel",
            "line": "$line"
          }
        }
      ]
    },
    {
      "id": "map",
      "label": "A pin on the dark map",
      "when": "The narration names one country or big city.",
      "ruleFirst": true,
      "params": {
        "place": {
          "type": "place",
          "required": true
        },
        "label": {
          "maxWords": 3,
          "required": false
        },
        "line": {
          "maxWords": 9,
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:map",
          "vars": {
            "place": "$place",
            "label": "$label",
            "line": "$line"
          }
        }
      ]
    },
    {
      "id": "board",
      "label": "The evidence board",
      "when": "Three or four clues, people or facts that belong together: cards pinned to a board, one string joining them.",
      "ruleFirst": true,
      "params": {
        "item1": {
          "maxWords": 3,
          "required": true
        },
        "item2": {
          "maxWords": 3,
          "required": true
        },
        "item3": {
          "maxWords": 3,
          "required": true
        },
        "item4": {
          "maxWords": 3,
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:board",
          "vars": {
            "item1": "$item1",
            "item2": "$item2",
            "item3": "$item3",
            "item4": "$item4"
          }
        }
      ]
    },
    {
      "id": "evidence",
      "label": "One thing under a lamp",
      "when": "One thing that was found or that matters: it lies on a table in a pool of light.",
      "ruleFirst": true,
      "params": {
        "object": {
          "type": "object",
          "required": true
        },
        "line": {
          "maxWords": 6,
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:evidence",
          "vars": {
            "object": "$object",
            "line": "$line"
          }
        }
      ]
    },
    {
      "id": "number",
      "label": "A number that glows",
      "when": "The narration says a number and it matters.",
      "params": {
        "value": {
          "type": "number",
          "required": true,
          "said": true
        },
        "before": {
          "maxWords": 1,
          "required": false
        },
        "after": {
          "maxWords": 1,
          "required": false
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:number",
          "vars": {
            "value": "$value",
            "before": "$before",
            "after": "$after",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "street",
      "label": "Somebody walks at night",
      "when": "The story is outside: a street, a road, a car, a night.",
      "ruleFirst": true,
      "params": {
        "object": {
          "type": "object",
          "required": true
        },
        "line": {
          "maxWords": 9,
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:street",
          "vars": {
            "object": "$object",
            "line": "$line"
          }
        }
      ]
    },
    {
      "id": "room",
      "label": "Somebody crosses a room",
      "when": "The story is inside a house, a room or an office.",
      "ruleFirst": true,
      "fallback": true,
      "params": {
        "object": {
          "type": "object",
          "required": true
        },
        "line": {
          "maxWords": 9,
          "required": false
        }
      },
      "use": [
        {
          "component": "night-case-file:room",
          "vars": {
            "object": "$object",
            "line": "$line"
          }
        }
      ]
    }
  ]
