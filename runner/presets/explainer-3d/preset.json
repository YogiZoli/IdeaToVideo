{
  "schema": "style-preset/1",
  "id": "explainer-3d",
  "label": "3D Explainer",
  "description": "One strange question per video. Simple 3D scenes drawn on this computer: soft-shaded objects, cutaway views, scale comparisons, bright clean materials, smooth camera moves.",
  "engine": "script",
  "scriptNote": "The whole video answers one strange, concrete question. Ask it in the first sentence and answer it at the end. Prefer things the viewer can picture: real sizes, side by side comparisons, what is inside something.",
  "ideaNote": "Each video is one strange, concrete question, the kind that starts with what if, how big or why does.",
  "defaults": {
    "broll": false
  },
  "tokens": {
    "appearance": "light",
    "colors": {
      "background": "#eaf2f9",
      "surface": "#d7e4f1",
      "border": "#bccde0",
      "text": "#16233b",
      "muted": "#566780",
      "primary": "#f2542d",
      "secondary": "#129a8d",
      "tertiary": "#ffbe3d"
    },
    "fonts": {
      "display": "Outfit",
      "body": "DM Sans"
    },
    "shape": {
      "corners": "large",
      "cards": "flat"
    },
    "texture": "none"
  },
  "shotRules": {
    "pacing": "balanced",
    "cutFrequency": "A new 3D scene every 3 to 5 seconds, each on a sentence or on the word its main text says.",
    "camera": "One slow, smooth move per scene: a push in, a small orbit, or a pull back that reveals scale. The scene owns it, not the channel's Motion profile.",
    "characters": "No real people. A person is a faceless figure drawn by code. Objects stand on a clean floor with a soft shadow.",
    "sound": "No transition sounds. The narration carries the video, the music sits under it."
  },
