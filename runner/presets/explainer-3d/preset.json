      "ruleFirst": true,
      "params": {
        "from": {
          "maxWords": 3,
          "required": true
        },
        "to": {
          "maxWords": 3,
          "required": true
        },
        "fromObject": {
          "type": "object",
          "required": true
        },
        "toObject": {
          "type": "object",
          "required": true
        }
      },
      "use": [
        {
          "component": "explainer-3d:cause",
          "vars": {
            "from": "$from",
            "to": "$to",
            "fromObject": "$fromObject",
            "toObject": "$toObject"
