  "templates": [
    {
      "id": "title",
      "label": "Question over one object",
      "when": "The first scene: the video's one strange question, with the thing it is about.",
      "params": {
        "headline": {
          "maxWords": 6,
          "required": true
        },
        "object": {
          "type": "object",
          "required": true
        },
        "kicker": {
          "maxWords": 4,
          "required": false
        }
      },
      "use": [
        {
          "component": "explainer-3d:title",
          "vars": {
            "headline": "$headline",
            "object": "$object",
            "kicker": "$kicker"
          }
        }
      ]
    },
    {
      "id": "chapter",
      "label": "Chapter on a turntable",
      "when": "The start of a new section.",
      "params": {
        "headline": {
          "maxWords": 5,
          "required": true
        },
        "object": {
          "type": "object",
          "required": true
        }
      },
      "use": [
        {
          "component": "explainer-3d:chapter",
          "vars": {
            "headline": "$headline",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "statement",
      "label": "Object and two lines",
      "when": "A claim: the first line sets it up, the second lands it.",
      "params": {
        "line1": {
          "maxWords": 5,
          "required": true
        },
        "line2": {
          "maxWords": 4,
          "required": true
        },
        "object": {
          "type": "object",
          "required": true
        }
      },
      "use": [
        {
          "component": "explainer-3d:statement",
          "vars": {
            "line1": "$line1",
            "line2": "$line2",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "word",
      "label": "One huge word",
      "when": "One word is the whole point.",
      "params": {
        "word": {
          "maxWords": 2,
          "required": true
        },
        "object": {
          "type": "object",
          "required": true
        }
      },
      "use": [
        {
          "component": "explainer-3d:word",
          "vars": {
            "word": "$word",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "highlight",
      "label": "Marked line",
      "when": "A short line with one key word to mark.",
      "params": {
        "line": {
          "maxWords": 6,
          "required": true
        },
        "mark": {
          "maxWords": 1,
          "required": true
        },
        "object": {
          "type": "object",
          "required": true
        }
      },
      "use": [
        {
          "component": "explainer-3d:highlight",
          "vars": {
            "line": "$line",
            "mark": "$mark",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "question",
      "label": "Question mark",
      "when": "The narration asks the viewer something.",
      "ruleFirst": true,
      "params": {
        "question": {
          "maxWords": 6,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "explainer-3d:question",
          "vars": {
            "question": "$question",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "number",
      "label": "Number and a pile",
      "when": "The narration says a number and it matters; the object is what is counted.",
      "params": {
        "value": {
          "type": "number",
          "required": true,
          "said": true
        },
        "before": {
          "maxWords": 1,
          "required": false
        },
        "after": {
          "maxWords": 1,
          "required": false
        },
        "object": {
          "type": "object",
          "required": true
        }
      },
      "use": [
        {
          "component": "explainer-3d:number",
          "vars": {
            "value": "$value",
            "before": "$before",
            "after": "$after",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "percent",
      "label": "Tank fills up",
      "when": "The narration says a percentage.",
      "params": {
        "value": {
          "type": "number",
          "required": true,
          "said": true
        }
      },
      "use": [
        {
          "component": "explainer-3d:percent",
          "vars": {
            "value": "$value"
          }
        }
      ]
    },
    {
      "id": "scale",
      "label": "Scale comparison",
      "when": "How big one thing is next to another: the camera pulls back from the small one.",
      "ruleFirst": true,
      "params": {
        "small": {
          "maxWords": 3,
          "required": true
        },
        "big": {
          "maxWords": 3,
          "required": true
        },
        "smallObject": {
          "type": "object",
          "required": true
        },
        "bigObject": {
          "type": "object",
          "required": true
        },
        "ratio": {
          "maxWords": 3,
          "required": false
        }
      },
      "use": [
        {
          "component": "explainer-3d:scale",
          "vars": {
            "small": "$small",
            "big": "$big",
            "smallObject": "$smallObject",
            "bigObject": "$bigObject",
            "ratio": "$ratio"
          }
        }
      ]
    },
    {
      "id": "cutaway",
      "label": "Cutaway view",
      "when": "What is inside something: a ball cut open, up to three named layers.",
      "ruleFirst": true,
      "params": {
        "headline": {
          "maxWords": 5,
          "required": true
        },
        "object": {
          "type": "object",
          "required": true
        },
        "outer": {
          "maxWords": 3,
          "required": false
        },
        "middle": {
          "maxWords": 3,
          "required": false
        },
        "inner": {
          "maxWords": 3,
          "required": false
        }
      },
      "use": [
        {
          "component": "explainer-3d:cutaway",
          "vars": {
            "headline": "$headline",
            "object": "$object",
            "outer": "$outer",
            "middle": "$middle",
            "inner": "$inner"
          }
        }
      ]
    },
    {
      "id": "versus",
      "label": "Two sides on plinths",
      "when": "This or that, before and after, wrong and right.",
      "ruleFirst": true,
      "params": {
        "left": {
          "maxWords": 4,
          "required": true
        },
        "right": {
          "maxWords": 4,
          "required": true
        },
        "leftObject": {
          "type": "object",
          "required": true
        },
        "rightObject": {
          "type": "object",
          "required": true
        }
      },
