        "item2": {
          "maxWords": 3,
          "required": true
        },
        "item3": {
          "maxWords": 3,
          "required": true
        },
        "item4": {
          "maxWords": 3,
          "required": true
        },
        "object1": {
          "type": "object",
          "required": true
        },
        "object2": {
          "type": "object",
          "required": true
        },
        "object3": {
          "type": "object",
          "required": true
