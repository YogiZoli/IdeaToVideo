            "item1": "$item1",
            "item2": "$item2",
            "item3": "$item3",
            "item4": "$item4",
            "object1": "$object1",
            "object2": "$object2",
            "object3": "$object3",
            "object4": "$object4"
          }
        }
      ]
    }
  ]
