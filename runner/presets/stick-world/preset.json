{
  "schema": "style-preset/1",
  "id": "stick-world",
  "label": "Stick World",
  "description": "What-if stories told to you. Black stick figures on a light plain background, you are the one with the colored scarf. A nearly still camera, one short sentence per shot, big readable numbers.",
  "engine": "script",
  "scriptNote": "A what-if story that happens to the viewer. Talk to the viewer as you, and tell it in order, one thing after another. Write short sentences of 6 to 12 words, one thought per sentence, because each one gets its own shot and a shot lasts at least 2 seconds. Say the key numbers in digits.",
  "ideaNote": "Each video is one what-if story that happens to the viewer, the kind that starts with what if you.",
  "defaults": {
    "broll": false
  },
  "tokens": {
    "appearance": "light",
    "colors": {
      "background": "#f6f4ee",
      "surface": "#ffffff",
      "border": "#d9d5ca",
      "text": "#141414",
      "muted": "#6a675f",
      "primary": "#e0332e",
      "secondary": "#141414",
      "tertiary": "#6a675f"
    },
    "fonts": {
      "display": "Rubik",
      "body": "Quicksand"
    },
    "shape": {
      "corners": "large",
      "cards": "flat"
    },
    "texture": "none"
  },
  "shotRules": {
    "pacing": "fast",
    "cutFrequency": "One short sentence per shot: a new shot on every sentence.",
    "camera": "Nearly still: a push in of under 2% over the shot, nothing else. The scene owns it, not the channel's Motion profile.",
    "characters": "Black stick figures drawn by code. The hero, you, wears one accent-colored scarf. They blink every 3.5 to 4 seconds and their feet stay planted when they walk.",
    "sound": "No transition sounds. The narration carries the video, the music sits under it."
  },
