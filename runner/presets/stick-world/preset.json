  "templates": [
    {
      "id": "title",
      "label": "The question and you",
      "when": "The first scene: the video's what-if question, with you standing by the thing it is about.",
      "params": {
        "headline": {
          "maxWords": 8,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        },
        "kicker": {
          "maxWords": 4,
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:title",
          "vars": {
            "headline": "$headline",
            "object": "$object",
            "kicker": "$kicker"
          }
        }
      ]
    },
    {
      "id": "chapter",
      "label": "You walk into a new part",
      "when": "The start of a new part of the story.",
      "params": {
        "headline": {
          "maxWords": 5,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:chapter",
          "vars": {
            "headline": "$headline",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "statement",
      "label": "You and two lines",
      "when": "A plain claim: the first line sets it up, the second lands it.",
      "params": {
        "line1": {
          "maxWords": 5,
          "required": true
        },
        "line2": {
          "maxWords": 4,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:statement",
          "vars": {
            "line1": "$line1",
            "line2": "$line2",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "word",
      "label": "One huge word",
      "when": "One word is the whole point, and you throw your arms up.",
      "params": {
        "word": {
          "maxWords": 2,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:word",
          "vars": {
            "word": "$word",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "highlight",
      "label": "Marked line",
      "when": "A short line with one key word to mark.",
      "params": {
        "line": {
          "maxWords": 6,
          "required": true
        },
        "mark": {
          "maxWords": 1,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:highlight",
          "vars": {
            "line": "$line",
            "mark": "$mark",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "question",
      "label": "You shrug",
      "when": "The narration asks the viewer something.",
      "ruleFirst": true,
      "params": {
        "question": {
          "maxWords": 6,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:question",
          "vars": {
            "question": "$question",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "versus",
      "label": "You and them",
      "when": "This or that, before and after, you and someone else.",
      "ruleFirst": true,
      "params": {
        "left": {
          "maxWords": 4,
          "required": true
        },
        "right": {
          "maxWords": 4,
          "required": true
        },
        "leftObject": {
          "type": "object",
          "required": false
        },
        "rightObject": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:versus",
          "vars": {
            "left": "$left",
            "right": "$right",
            "leftObject": "$leftObject",
            "rightObject": "$rightObject"
          }
        }
      ]
    },
    {
      "id": "cause",
      "label": "A leads to B",
      "when": "One thing causes or leads to another.",
      "ruleFirst": true,
      "params": {
        "from": {
          "maxWords": 3,
          "required": true
        },
        "to": {
          "maxWords": 3,
          "required": true
        },
        "fromObject": {
          "type": "object",
          "required": false
        },
        "toObject": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:cause",
          "vars": {
            "from": "$from",
            "to": "$to",
            "fromObject": "$fromObject",
            "toObject": "$toObject"
          }
        }
      ]
    },
    {
      "id": "thought",
      "label": "A thought cloud",
      "when": "You imagine, wish or wonder about something: it floats in a cloud.",
      "ruleFirst": true,
      "params": {
        "line": {
          "maxWords": 6,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:thought",
          "vars": {
            "line": "$line",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "talk",
      "label": "Two people talk",
      "when": "Someone says, asks or tells something: it is in your speech bubble.",
      "ruleFirst": true,
      "params": {
        "said": {
          "maxWords": 6,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:talk",
          "vars": {
            "said": "$said",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "walk",
      "label": "You walk to it",
      "when": "You go somewhere: you walk across the frame to the thing.",
      "ruleFirst": true,
      "params": {
        "line": {
          "maxWords": 6,
          "required": true
        },
        "object": {
          "type": "object",
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:walk",
          "vars": {
            "line": "$line",
            "object": "$object"
          }
        }
      ]
    },
    {
      "id": "number",
      "label": "A big number and people",
      "when": "The narration says a number and it matters. Under 10 shows exactly that many people.",
      "params": {
        "value": {
          "type": "number",
          "required": true,
          "said": true
        },
        "before": {
          "maxWords": 1,
          "required": false
        },
        "after": {
          "maxWords": 1,
          "required": false
        }
      },
      "use": [
        {
          "component": "stick-world:number",
          "vars": {
            "value": "$value",
            "before": "$before",
            "after": "$after"
          }
        }
      ]
    },
    {
      "id": "percent",
      "label": "100 people, some marked",
      "when": "The narration says a percentage.",
      "params": {
        "value": {
          "type": "number",
          "required": true,
          "said": true
        }
      },
      "use": [
        {
          "component": "stick-world:percent",
          "vars": {
            "value": "$value"
          }
        }
      ]
    },
    {
      "id": "path",
      "label": "Four stops",
      "when": "Exactly four steps in order: you walk past four signs.",
      "params": {
        "step1": {
          "maxWords": 3,
          "required": true
        },
        "step2": {
          "maxWords": 3,
          "required": true
        },
        "step3": {
          "maxWords": 3,
          "required": true
        },
        "step4": {
          "maxWords": 3,
          "required": true
        }
      },
      "use": [
        {
          "component": "stick-world:path",
          "vars": {
            "step1": "$step1",
            "step2": "$step2",
            "step3": "$step3",
            "step4": "$step4"
          }
        }
      ]
    }
  ]
}
