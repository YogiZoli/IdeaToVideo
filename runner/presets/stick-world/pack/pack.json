        {
          "id": "line",
          "type": "string",
          "label": "Line",
          "default": "",
          "maxWords": 6
        },
        {
          "id": "mark",
          "type": "string",
          "label": "Mark",
          "default": "",
          "maxWords": 1
        },
        {
          "id": "object",
          "type": "string",
          "label": "Object",
          "default": "none",
          "optional": true
        }
      ],
      "seconds": 5
    },
    {
      "id": "question",
      "role": "statement",
      "label": "You shrug",
