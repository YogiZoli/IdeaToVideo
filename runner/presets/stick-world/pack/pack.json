        {
          "id": "left",
          "type": "string",
          "label": "Left",
          "default": "",
          "maxWords": 4
        },
        {
          "id": "right",
          "type": "string",
          "label": "Right",
          "default": "",
          "maxWords": 4
        },
        {
          "id": "leftObject",
          "type": "string",
          "label": "Left Object",
          "default": "none",
          "optional": true
        },
        {
          "id": "rightObject",
          "type": "string",
          "label": "Right Object",
          "default": "none",
          "optional": true
        }
