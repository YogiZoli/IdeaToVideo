      "variables": [
        {
          "id": "line",
          "type": "string",
          "label": "Line",
          "default": "",
          "maxWords": 6
        },
        {
          "id": "object",
          "type": "string",
          "label": "Object",
          "default": "none",
          "optional": true
        }
      ],
      "seconds": 5
    },
    {
      "id": "talk",
      "role": "relation",
      "label": "Two people talk",
      "what": "Someone says, asks or tells something: it is in your speech bubble.",
      "variables": [
        {
          "id": "said",
          "type": "string",
          "label": "Said",
          "default": "",
          "maxWords": 6
        },
        {
          "id": "object",
          "type": "string",
          "label": "Object",
          "default": "none",
          "optional": true
        }
      ],
      "seconds": 5
    },
    {
      "id": "walk",
      "role": "statement",
      "label": "You walk to it",
      "what": "You go somewhere: you walk across the frame to the thing.",
      "variables": [
        {
          "id": "line",
          "type": "string",
          "label": "Line",
          "default": "",
          "maxWords": 6
        },
        {
          "id": "object",
          "type": "string",
          "label": "Object",
          "default": "none",
          "optional": true
        }
      ],
      "seconds": 5
    },
    {
      "id": "number",
      "role": "proof",
      "label": "A big number and people",
      "what": "The narration says a number and it matters. Under 10 shows exactly that many people.",
      "variables": [
        {
          "id": "value",
          "type": "number",
          "label": "Value",
          "default": 0
        },
        {
          "id": "before",
          "type": "string",
          "label": "Before",
          "default": "",
          "optional": true,
          "maxWords": 1
        },
        {
          "id": "after",
          "type": "string",
          "label": "After",
          "default": "",
          "optional": true,
          "maxWords": 1
        }
      ],
      "seconds": 5
    },
    {
      "id": "percent",
      "role": "proof",
      "label": "100 people, some marked",
      "what": "The narration says a percentage.",
      "variables": [
        {
          "id": "value",
          "type": "number",
          "label": "Value",
          "default": 0
        }
      ],
      "seconds": 5
    },
    {
      "id": "path",
      "role": "process",
      "label": "Four stops",
      "what": "Exactly four steps in order: you walk past four signs.",
      "variables": [
        {
          "id": "step1",
          "type": "string",
          "label": "Step 1",
          "default": "",
          "maxWords": 3
        },
        {
          "id": "step2",
          "type": "string",
          "label": "Step 2",
          "default": "",
          "maxWords": 3
        },
        {
          "id": "step3",
          "type": "string",
          "label": "Step 3",
          "default": "",
          "maxWords": 3
        },
        {
          "id": "step4",
          "type": "string",
          "label": "Step 4",
          "default": "",
          "maxWords": 3
        }
      ],
      "seconds": 5
    }
  ]
