        {
          "id": "to",
          "type": "string",
          "label": "To",
          "default": "",
          "maxWords": 3
        },
        {
          "id": "fromObject",
          "type": "string",
          "label": "From Object",
          "default": "none",
          "optional": true
        },
        {
          "id": "toObject",
          "type": "string",
          "label": "To Object",
          "default": "none",
          "optional": true
        }
      ],
      "seconds": 5
    },
    {
      "id": "thought",
      "role": "detail",
      "label": "A thought cloud",
