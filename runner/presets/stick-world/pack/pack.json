{
  "schema": "itv-pack/1",
  "id": "stick-world",
  "name": "Stick World",
  "look": "own",
  "camera": "Nearly still",
  "runtime": [],
  "script": "shared/stick.js",
  "blocks": [
    {
      "id": "title",
      "role": "opening",
      "label": "The question and you",
      "what": "The first scene: the video's what-if question, with you standing by the thing it is about.",
      "variables": [
        {
          "id": "headline",
          "type": "string",
          "label": "Headline",
          "default": "",
          "maxWords": 8
        },
        {
          "id": "object",
          "type": "string",
          "label": "Object",
          "default": "none",
          "optional": true
        },
        {
          "id": "kicker",
          "type": "string",
          "label": "Kicker",
          "default": "",
          "optional": true,
          "maxWords": 4
        }
      ],
      "seconds": 5
    },
    {
      "id": "chapter",
      "role": "opening",
      "label": "You walk into a new part",
      "what": "The start of a new part of the story.",
      "variables": [
        {
          "id": "headline",
          "type": "string",
          "label": "Headline",
          "default": "",
          "maxWords": 5
        },
        {
          "id": "object",
          "type": "string",
          "label": "Object",
          "default": "none",
          "optional": true
        }
      ],
      "seconds": 5
    },
    {
      "id": "statement",
      "role": "statement",
      "label": "You and two lines",
      "what": "A plain claim: the first line sets it up, the second lands it.",
      "variables": [
        {
          "id": "line1",
          "type": "string",
          "label": "Line 1",
          "default": "",
          "maxWords": 5
        },
        {
          "id": "line2",
          "type": "string",
          "label": "Line 2",
          "default": "",
          "maxWords": 4
        },
        {
          "id": "object",
          "type": "string",
          "label": "Object",
          "default": "none",
          "optional": true
        }
      ],
      "seconds": 5
    },
    {
      "id": "word",
      "role": "emphasis",
      "label": "One huge word",
      "what": "One word is the whole point, and you throw your arms up.",
      "variables": [
        {
          "id": "word",
          "type": "string",
          "label": "Word",
          "default": "",
          "maxWords": 2
        },
        {
          "id": "object",
          "type": "string",
          "label": "Object",
          "default": "none",
          "optional": true
        }
      ],
      "seconds": 5
    },
    {
      "id": "highlight",
      "role": "emphasis",
      "label": "Marked line",
