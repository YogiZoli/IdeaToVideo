{
  "schema": "style-preset/1",
  "id": "soft-clay",
  "label": "Soft Clay Chronicle",
  "description": "A warm history documentary in matte clay. Rounded faceless figures, hand-pressed things with a faint fingerprint texture, warm lamp light on an old map table, a soft glow on the thing the story is about, a small date label in the corner.",
  "engine": "script",
  "scriptNote": "A piece of history told as a warm story, in the order it happened. Say each date and each place out loud, and the key numbers in digits. Write sentences of 8 to 16 words, each about one thing the viewer can picture: a ship, a crown, a letter, a bridge. Call people by their role, and never describe a real person's looks. If a fact is uncertain, say that it is.",
  "ideaNote": "Each video tells one moment or one thing from history as a warm story, in the order it happened, with its dates and places.",
  "defaults": {
    "broll": false,
    "research": true,
    "mood": "warm"
  },
  "tokens": {
    "appearance": "dark",
    "colors": {
      "background": "#1a100a",
      "surface": "#2b1c12",
      "border": "#4d3524",
      "text": "#f6e8cf",
      "muted": "#b79e80",
      "primary": "#e07a4a",
      "secondary": "#8f9e5a",
      "tertiary": "#e6b45a"
    },
    "fonts": {
      "display": "Playfair Display",
      "body": "Source Serif 4"
    },
    "shape": {
      "corners": "soft",
      "cards": "paper notes"
    },
    "texture": "matte clay with a faint fingerprint, old paper"
  },
  "shotRules": {
    "pacing": "balanced",
    "cutFrequency": "A new scene every 3 to 5 seconds, each on a sentence or on the word its main text says, plain cuts.",
    "camera": "One slow move per scene around the table: a push in, a small orbit, or a look down at the map. The scene owns it, not the channel's Motion profile.",
    "characters": "Rounded faceless figures made of clay, told apart only by what they wear. Never a recognizable real person.",
    "sound": "No transition sounds. The narration carries the video, warm music sits under it."
  },
  "places": "../archive-collage/places.json",
  "assets": [
    {
      "title": "Natural Earth 1:50m countries and 1:110m populated places, simplified",
      "source": "natural-earth",
      "sourceUrl": "https://www.naturalearthdata.com/",
      "license": "pd",
      "licenseUrl": "https://www.naturalearthdata.com/about/terms-of-use/",
      "author": "Natural Earth",
      "date": "2026-11-03"
    }
  ],
