  "templates": [
    {
      "id": "title",
      "label": "One thing in the lamp's glow",
      "when": "The first scene: what the video is about, with the thing it is about.",
      "params": {
        "headline": {
          "maxWords": 6,
          "required": true
        },
        "object": {
          "type": "object",
          "required": true
        },
        "kicker": {
          "maxWords": 4,
          "required": false
        }
      },
      "use": [
        {
          "component": "soft-clay:title",
          "vars": {
            "headline": "$headline",
            "object": "$object",
            "kicker": "$kicker"
          }
        }
      ]
    },
    {
