{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-save",
    "core:window:allow-request-user-attention"
  ]
}
