{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecCut",
  "mainBinaryName": "reccut",
  "identifier": "app.reccut.desktop",
  "build": {
    "beforeDevCommand": "node ../scripts/fetch-sidecars.mjs && npm run dev:editor",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "node ../scripts/fetch-sidecars.mjs && npm ci --prefix ../runner --no-audit --no-fund && node ../scripts/prune-runner.mjs && npm run build:editor",
    "frontendDist": "../build-editor"
  },
  "app": {
    "windows": [
      {
        "title": "RecCut",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "maximized": true
      }
    ]
  },
  "bundle": {
    "shortDescription": "A recording in, a finished video out, on your own machine",
    "icon": [
      "icons-reccut/32x32.png",
      "icons-reccut/128x128.png",
      "icons-reccut/128x128@2x.png",
      "icons-reccut/icon.icns",
      "icons-reccut/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons-reccut/icon.ico"
      }
    }
  }
}