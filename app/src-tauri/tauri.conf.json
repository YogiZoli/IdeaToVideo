{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IdeaToVideo",
  "version": "0.1.0",
  "identifier": "app.ideatovideo.desktop",
  "build": {
    "beforeDevCommand": "node ../scripts/fetch-sidecars.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../scripts/fetch-sidecars.mjs && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "IdeaToVideo",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../../runner/": "runner/",
      "ffmpeg/": "ffmpeg/",
      "canon/": "canon/"
    },
    "shortDescription": "From idea to video, on your own machine",
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
